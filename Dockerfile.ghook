# pgoverlay-github container image (the Helm chart's optional ghook
# sub-deployment). Same pure-Go static build recipe as the branchd image.
# Base images pinned by digest (resolved from Docker Hub; supply-chain hygiene).
# Refresh with: docker buildx imagetools inspect golang:1.26.5-alpine (and alpine:3.21).
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /pgoverlay-github ./cmd/pgoverlay-github

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
# See Dockerfile: image.source is what links the GHCR package back to this repo.
LABEL org.opencontainers.image.source="https://github.com/abd-ulbasit/pgoverlay" \
      org.opencontainers.image.description="pgoverlay ghook — a Postgres branch per pull request" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /pgoverlay-github /usr/local/bin/pgoverlay-github
# ghook is the internet-facing webhook receiver and needs no privileges: run as
# a non-root, non-existent UID so the image is non-root even outside the chart
# (the Helm chart additionally pins runAsNonRoot/runAsUser=65532 and drops all
# caps). 65532 = the conventional "nonroot" distroless UID.
USER 65532:65532
ENTRYPOINT ["pgoverlay-github"]
